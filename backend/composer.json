{
  "name": "shlz/test-request-registry",
  "description": "Backend регистратора заявок на проведение испытаний АО ЩЛЗ",
  "type": "project",
  "license": "proprietary",
  "require": {
    "php": "^8.3",
    "ext-dom": "*",
    "ext-json": "*",
    "ext-ldap": "*",
    "ext-mbstring": "*",
    "ext-pcntl": "*",
    "ext-pdo": "*",
    "ext-zip": "*",
    "dompdf/dompdf": "^3.1",
    "symfony/mailer": "^7.0",
    "yiisoft/yii2": "^2.0"
  },
  "require-dev": {
    "phpstan/phpstan": "^2.1",
    "phpunit/phpunit": "^11.0",
    "squizlabs/php_codesniffer": "^4.0"
  },
  "autoload": {
    "psr-4": {
      "App\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Tests\\": "tests/"
    }
  },
  "config": {
    "allow-plugins": {
      "yiisoft/yii2-composer": true
    },
    "sort-packages": true
  },
  "replace": {
    "bower-asset/inputmask": "*",
    "bower-asset/jquery": "*",
    "bower-asset/punycode": "*",
    "bower-asset/yii2-pjax": "*"
  },
  "scripts": {
    "lint": "phpcs -n",
    "analyse": "phpstan analyse --no-progress --memory-limit=512M",
    "test": "phpunit --colors=always",
    "test:integration": "phpunit -c phpunit.integration.xml --colors=always"
  }
}
