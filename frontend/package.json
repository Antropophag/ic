{
  "name": "shlz-test-registry-prototype",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "vite build",
    "bitrix-files": "node scripts/bitrix-files.mjs",
    "lint": "eslint . --max-warnings=0",
    "openapi:validate": "node scripts/check-openapi.mjs",
    "audit": "npm audit --audit-level=high",
    "test": "vitest run",
    "coverage": "vitest run --coverage && vitest run --config vitest.workflow.config.js --coverage",
    "e2e": "playwright test"
  },
  "dependencies": {
    "@fontsource/fira-sans": "^5.3.0",
    "@vitejs/plugin-vue": "latest",
    "swagger-ui-dist": "5.32.12",
    "vite": "8.2.4",
    "vue": "3.5.46"
  },
  "devDependencies": {
    "@apidevtools/swagger-parser": "12.1.0",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.62.1",
    "@vitest/coverage-v8": "5.1.1",
    "eslint": "10.15.0",
    "eslint-plugin-vue": "10.10.0",
    "globals": "17.9.0",
    "happy-dom": "21.0.4",
    "markdownlint": "0.41.1",
    "tinyglobby": "0.2.17",
    "vitest": "5.1.1"
  },
  "overrides": {
    "micromark-extension-math": {
      "katex": "0.18.2"
    }
  }
}
