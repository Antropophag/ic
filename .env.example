COMPOSE_PROJECT_NAME=ic-prod
COMPOSE_FILE=compose.yaml
COMPOSE_ENV_FILE=.env.prod
DOWNLOAD_LINK_SIGNING_KEY=replace-with-a-different-at-least-32-random-characters
FRONTEND_PORT=8080
APP_DEBUG=0
APP_VERSION=0.1.0
APP_COMMIT_SHA=
APP_BUILD_TIMESTAMP=
COOKIE_VALIDATION_KEY=replace-with-at-least-32-random-characters
DB_HOST=mariadb
DB_PORT=3306
DB_NAME=ic
DB_USER=ic
DB_PASSWORD=change-me
DB_ROOT_PASSWORD=change-root-password
# Канонические sAMAccountName через запятую (например login1,login2), которым
# после развёртывания нужно выдать локальные роли employee и administrator.
# Допустимы латинские буквы, цифры, точка, дефис и подчёркивание; пробелы вокруг
# элементов обрезаются, пустые элементы запрещены. Пустое значение допустимо,
# только если в локальной БД уже есть активный administrator. Удаление логина
# не отзывает ранее выданную роль.
BOOTSTRAP_ADMIN_AD_LOGINS=
# Аварийный локальный вход. Оба значения должны быть заданы либо оба оставлены
# пустыми. Hash помещайте в одинарные кавычки: они сохраняют символы `$` при
# чтении Compose env_file. Генерация и ротация описаны в docs/devops-contract.md.
BREAK_GLASS_LOGIN=
BREAK_GLASS_PASSWORD_HASH=''
LDAP_HOST=10.178.80.80
LDAP_PORT=389
LDAP_DOMAIN=shlz.ru
LDAP_BASE_DN=DC=shlz,DC=local
LDAP_USE_TLS=false
BITRIX24_WEBHOOK_URL=
BITRIX24_REQUESTS_LIST_ID=114
BITRIX24_REQUESTS_IBLOCK_TYPE=lists
DOCUMENT_STORAGE_PATH=/app/storage/documents
SMTP_HOST=10.178.69.91
SMTP_PORT=587
SMTP_SECURE=tls
SMTP_USERNAME=k2mailer@shlz.ru
SMTP_PASSWORD=
SMTP_TIMEOUT=5
# Внутренний релей использует самоподписанный сертификат. По умолчанию
# сертификат проверяется (SMTP_VERIFY_PEER=1) — 0 нужен только для этого
# конкретного релея и должен оставаться явной настройкой, а не кодом.
SMTP_VERIFY_PEER=0
MAIL_FROM_ADDRESS=k2mailer@shlz.ru
MAIL_FROM_NAME=Регистратор заявок на испытания
# Базовый адрес портала для активных ссылок на скачивание документов в
# письмах-уведомлениях (ТЗ 4.6/4.9/4.10).
APP_PUBLIC_URL=http://localhost:8080
# Тестовый режим: перенаправляет все исходящие письма на один ящик (тема и
# тело сохраняют настоящего получателя). Не задавать в проде — по умолчанию
# пусто, обычная доставка.
NOTIFICATION_TEST_REDIRECT_EMAIL=
