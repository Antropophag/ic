COMPOSE_PROJECT_NAME=ic-dev
COMPOSE_FILE=compose.yaml:compose.dev.yaml
COMPOSE_ENV_FILE=.env.dev
FRONTEND_PORT=8081
APP_DEBUG=1
APP_PUBLIC_URL=http://localhost:8081
BITRIX24_REQUESTS_IBLOCK_TYPE=lists
BITRIX24_REQUESTS_LIST_ID=
BITRIX24_WEBHOOK_URL=
COOKIE_VALIDATION_KEY=replace-with-a-local-random-value
BREAK_GLASS_LOGIN=
BREAK_GLASS_PASSWORD_HASH=''
DB_HOST=mariadb
DB_NAME=ic_dev
DB_PASSWORD=change-me
DB_PORT=3306
DB_ROOT_PASSWORD=change-root-password
DB_USER=ic
DOCUMENT_STORAGE_PATH=/app/storage/documents
LDAP_BASE_DN=DC=example,DC=test
LDAP_DOMAIN=example.test
LDAP_HOST=ad.example.test
LDAP_PORT=636
LDAP_USE_TLS=true
MAIL_FROM_ADDRESS=portal@example.test
MAIL_FROM_NAME="Регистратор заявок на испытания"
NOTIFICATION_TEST_REDIRECT_EMAIL=
SMTP_HOST=smtp.example.test
SMTP_PASSWORD=
SMTP_PORT=587
SMTP_SECURE=tls
SMTP_TIMEOUT=5
SMTP_USERNAME=
SMTP_VERIFY_PEER=1
